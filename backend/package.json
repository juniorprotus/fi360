  "description": "Fleet Intelligence 360 (FI360) Modular Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "test:auth": "tsx src/scripts/test-auth.ts",
    "test:auth:memory": "tsx src/scripts/test-auth-memory.ts",
    "test:body-parser": "tsx src/scripts/test-body-parser.ts",
    "test:schemas": "tsx src/scripts/test-schemas.ts",
    "test:users": "tsx src/scripts/test-users.ts",
    "test:users:memory": "tsx src/scripts/test-users-memory.ts"
  },
  "keywords": [
